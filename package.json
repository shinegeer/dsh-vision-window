{
  "name": "@dsh-external/dsh-client-ui-vision-window",
  "description": "Enables single-modal AIs to recognize images: paste multiple screenshots into the window, configure a multimodal AI, and it automatically recognizes and archives them into 已识别图片. Independent window, modular design, easy to uninstall. 方便单模态 AI 识图：可粘贴多张截图到窗口，配置多模态 AI，AI 自动识图并归档到「已识别图片」。独立窗口、模块化设计，便于卸载。",
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "assets",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "vision",
    "image",
    "image-recognition",
    "ocr",
    "识图"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinegeer/dsh-vision-window.git"
  },
  "author": "shinegeer",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/image-utils.js && node --check lib/local-tools.js",
    "test": "node --test",
    "prepack": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "potrace": "^2.1.8",
    "puppeteer-core": "^25.7.0",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "allowScripts": {
    "sharp@0.35.3": true
  }
}
